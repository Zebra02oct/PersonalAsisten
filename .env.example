# Environment Variables Template
#
# Copy this file to `.env` and fill in the real values:
#     copy .env.example .env      (Windows cmd)
#     cp .env.example .env        (PowerShell / Git Bash)
#
# `.env` is git-ignored (see .gitignore) - never commit real credentials.
# This template MUST stay secret-free: only empty values or obvious
# placeholders, never a real password / API key / token.
#
# The current code only reads the five DB_* variables below
# (src/database/connection.py). The remaining variables are placeholders for
# the dashboard/API phases described in ROADMAP.md and are read with a
# default, so leaving them empty is safe today.
#
# Loaded via python-dotenv; see src/database/connection.py for the actual
# os.getenv() calls.

# ================================
# DATABASE CONFIGURATION (MySQL)
# ================================
# Host of the MySQL server. 'localhost' for a local Laragon/XAMPP install.
DB_HOST=localhost

# Port the MySQL server listens on (MySQL/MariaDB default: 3306).
DB_PORT=3306

# MySQL user used by the application. Grant it only the privileges it needs
# (SELECT/INSERT/UPDATE/DELETE) instead of using 'root' where possible.
DB_USER=root

# Password for DB_USER. LEAVE EMPTY IN THIS TEMPLATE.
# The live value belongs in your local, git-ignored `.env` only.
DB_PASSWORD=

# Name of the database. Must already exist; the ORM creates the TABLES
# inside it, not the database itself.
DB_NAME=asisten_db

# ================================
# WEATHER API (Phase 3 - not implemented yet)
# ================================
# API key for the weather provider of your choice (OpenWeatherMap, etc.).
# Empty means "weather feature disabled"; the dashboard must degrade
# gracefully when it is empty.
WEATHER_API_KEY=

# ================================
# GITHUB API (Phase 3 - not implemented yet)
# ================================
# Personal access token (fine-grained PAT with read-only repo scope).
# Empty means "GitHub panel disabled". Never use a token with write scope.
GITHUB_TOKEN=

# ================================
# APPLICATION SETTINGS
# ================================
# TCP port the dashboard/API server will bind to (Phase 4 - not implemented
# yet). The Flutter client on a phone must use the LAN IP of this machine,
# not 'localhost'.
APP_PORT=5000

# Verbose logging / auto-reload. Keep 'false' in production.
DEBUG_MODE=false
